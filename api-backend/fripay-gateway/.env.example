# =============================================================================
# FriPay API Gateway — Variables d'environnement
# =============================================================================

# Stockage du rate limiter et circuit breaker
# 'file' : défaut, adapté au déploiement mono-instance
# 'redis' : requis pour le multi-instance (Redis partagé)
GATEWAY_STORAGE_DRIVER=file

# Redis (requis si GATEWAY_STORAGE_DRIVER=redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# CORS — origines autorisées (séparées par des virgules)
# En dev : http://localhost:3000,http://127.0.0.1:3000
# En prod : https://app.fripay.bj,https://admin.fripay.bj
FRIPAY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
